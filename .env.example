# FAL_KEY: Required for Fal.ai API calls (HeyGen Video, MiniMax, LivePortrait, etc.)
# Users configure this via the Secrets panel in AI Studio UI
FAL_KEY="MY_FAL_KEY"

# GEMINI_API_KEY: Optional Gemini API key if AI prompt assistance is used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
